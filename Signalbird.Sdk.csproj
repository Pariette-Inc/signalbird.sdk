<!--
  Signalbird SDK — .NET manifesti.

  Manifest KÖKTE durur (repo kuralı), kaynak `src/dotnet/Signalbird.Sdk/`
  altındadır. Diğer dillerin dosyaları derlemeye girmez: `EnableDefaultItems`
  kapalıdır ve yalnız .NET kaynağı açıkça eklenir — aksi hâlde MSBuild
  `src/**` altındaki her `.cs`'i toplamaya çalışırdı.

  Sürüm `VERSION` dosyasıyla kilitlidir; `node scripts/sync-version.mjs`
  buradaki `<Version>` alanını da yazar.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>

    <PackageId>Signalbird.Sdk</PackageId>
    <Version>1.8.1</Version>
    <Authors>Signalbird</Authors>
    <Description>Signalbird SDK — Telsiz (log), Gönderim (e-posta/SMS/push) ve Yönetim istemcisi. Bağımlılıksız, ASP.NET Core DI destekli.</Description>
    <PackageTags>signalbird;logging;notification;messaging;email;sms;push;chat;observability</PackageTags>
    <PackageProjectUrl>https://signalbird.io/sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pariette-Inc/signalbird.sdk</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/dotnet/Signalbird.Sdk/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Tek dış bağımlılık DI uzantısı içindir ve ASP.NET Core uygulamasında zaten
    yüklüdür. Çekirdek istemciler (Telsiz, Gönderim, Yönetim) onu KULLANMAZ:
    konsol uygulaması ya da Azure Function bunu getirmek zorunda kalmasın diye
    `IServiceCollection` yalnız uzantı sınıfında geçer.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>

</Project>
