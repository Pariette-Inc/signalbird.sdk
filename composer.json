{
    "name": "signalbird/sdk",
    "description": "Signalbird SDK — tek pakette çok dilli istemci (PHP / Laravel)",
    "type": "library",
    "keywords": [
        "signalbird",
        "sdk",
        "monitoring",
        "logging",
        "notification",
        "alert",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Signalbird",
            "email": "hello@signalbird.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Signalbird\\Sdk\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Signalbird\\Sdk\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Signalbird\\Sdk\\SignalbirdServiceProvider"
            ],
            "aliases": {
                "Signalbird": "Signalbird\\Sdk\\Facades\\Signalbird"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/src/node",
            "/src/go",
            "/src/swift",
            "/src/dotnet",
            "/src/android",
            "/dist",
            "/node_modules",
            "/vendor",
            "/composer.lock",
            "/package.json",
            "/package-lock.json",
            "/tsconfig.json",
            "/tsup.config.ts",
            "/scripts",
            "/.github",
            "/DEVLOG.md",
            "/DEVELOPMENT.md",
            "/CLAUDE.md"
        ]
    }
}
