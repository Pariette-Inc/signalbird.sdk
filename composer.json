{
  "name": "pariette/signalbird",
  "description": "Signalbird SDK — Telsiz (Radio), Gönderim (Messaging), Yönetim (Management) ve Partner istemcisi (PHP / Laravel)",
  "type": "library",
  "keywords": [
    "signalbird",
    "sdk",
    "telsiz",
    "radio",
    "logging",
    "notification",
    "alert",
    "laravel",
    "messaging",
    "email",
    "sms",
    "push",
    "chat",
    "webhook",
    "management",
    "partner",
    "provisioning",
    "embed",
    "mail-transport"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Signalbird",
      "email": "hello@signalbird.io"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "symfony/mailer": "^6.4|^7.0"
  },
  "autoload": {
    "psr-4": {
      "Signalbird\\Sdk\\": "src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Signalbird\\Sdk\\Tests\\": "tests/php/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Signalbird\\Sdk\\SignalbirdServiceProvider"
      ],
      "aliases": {
        "Signalbird": "Signalbird\\Sdk\\Facades\\Signalbird"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "archive": {
    "exclude": [
      "/src/node",
      "/src/browser",
      "/src/app",
      "/src/react",
      "/src/vue",
      "/src/angular",
      "/src/react-native",
      "/src/widget",
      "/src/go",
      "/src/python",
      "/src/swift",
      "/src/dotnet",
      "/src/kotlin",
      "/dist",
      "/node_modules",
      "/vendor",
      "/composer.lock",
      "/package.json",
      "/package-lock.json",
      "/tsconfig.json",
      "/tsup.config.ts",
      "/pyproject.toml",
      "/go.mod",
      "/Package.swift",
      "/build.gradle.kts",
      "/Signalbird.Sdk.csproj",
      "/scripts",
      "/.github",
      "/DEVLOG.md",
      "/DEVELOPMENT.md",
      "/CLAUDE.md",
      "/tests",
      "/phpunit.xml.dist",
      "/.phpunit.result.cache",
      "/.build",
      "/.gradle",
      "/.kotlin",
      "/bin",
      "/build",
      "/obj",
      "/.gitignore",
      "/VERSION"
    ]
  },
  "suggest": {
    "monolog/monolog": "Laravel log kanalını Telsiz'e bağlamak için (SignalbirdLogHandler)",
    "symfony/mailer": "MAIL_MAILER=signalbird posta taşıyıcısı için (Laravel'de zaten vardır)"
  }
}
