{
  "name": "@signalbird/sdk",
  "version": "1.1.0",
  "description": "Signalbird SDK — Telsiz (Radio), Gönderim (Messaging) ve sohbet widget'ı: sunucu ve tarayıcı",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/publish-web.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:php": "vendor/bin/phpunit",
    "parity": "node scripts/check-parity.mjs"
  },
  "keywords": [
    "signalbird",
    "sdk",
    "telsiz",
    "radio",
    "logging",
    "notification",
    "alert",
    "observability",
    "messaging",
    "email",
    "sms",
    "push",
    "chat",
    "live-chat",
    "widget"
  ],
  "author": "Signalbird",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pariette-Inc/signalbird.sdk.git"
  },
  "homepage": "https://signalbird.io/sdk",
  "bugs": {
    "url": "https://github.com/Pariette-Inc/signalbird.sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
